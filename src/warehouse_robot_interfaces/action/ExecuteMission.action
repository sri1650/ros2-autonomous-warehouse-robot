# Goal: ordered map-frame poses that make up one mission.
string mission_id
geometry_msgs/PoseStamped[] waypoints
---
# Result
uint8 SUCCEEDED=0
uint8 CANCELED=1
uint8 FAILED=2
uint8 status
string message
uint32 completed_waypoints
---
# Feedback
uint8 QUEUED=0
uint8 NAVIGATING=1
uint8 PAUSED=2
uint8 RECOVERING=3
uint8 current_state
uint32 active_waypoint
float32 completion
string detail
