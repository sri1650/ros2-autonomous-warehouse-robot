<?xml version="1.0"?>
<sdf version="1.9">
  <world name="warehouse">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>
    <model name="floor"><static>true</static><link name="link"><collision name="collision"><geometry><box><size>20 14 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 14 0.1</size></box></geometry><material><ambient>0.45 0.47 0.50 1</ambient><diffuse>0.45 0.47 0.50 1</diffuse></material></visual></link></model>
    <model name="north_wall"><static>true</static><pose>0 7 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>20 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.2 2</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -7 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>20 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.2 2</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>10 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 14 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 14 2</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-10 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 14 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 14 2</size></box></geometry></visual></link></model>
    <model name="rack_a"><static>true</static><pose>-3 2 0.75 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>5 1 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>5 1 1.5</size></box></geometry><material><ambient>0.1 0.2 0.35 1</ambient><diffuse>0.1 0.2 0.35 1</diffuse></material></visual></link></model>
    <model name="rack_b"><static>true</static><pose>3 2 0.75 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>5 1 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>5 1 1.5</size></box></geometry><material><ambient>0.1 0.2 0.35 1</ambient><diffuse>0.1 0.2 0.35 1</diffuse></material></visual></link></model>
    <model name="rack_c"><static>true</static><pose>-3 -3 0.75 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>5 1 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>5 1 1.5</size></box></geometry><material><ambient>0.1 0.2 0.35 1</ambient><diffuse>0.1 0.2 0.35 1</diffuse></material></visual></link></model>
    <model name="rack_d"><static>true</static><pose>3 -3 0.75 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>5 1 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>5 1 1.5</size></box></geometry><material><ambient>0.1 0.2 0.35 1</ambient><diffuse>0.1 0.2 0.35 1</diffuse></material></visual></link></model>
  </world>
</sdf>
